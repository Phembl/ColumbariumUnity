  m_Script: {fileID: 11500000, guid: 578f7e4190f57ff49bd5ec0e25776317, type: 3}
  m_Name: Narration_00_Prologue2
  m_EditorClassIdentifier: 
  text: "In this heavenly abode of great beauty, he drops the unnamed man, for him
    \u203Ato dress it and to keep it\u2039 <br>(Genesis 2:15).[\u2026] <br><br>He
    makes the gardener \u203Aan help\u2039 from the man\u2019s rib [\u2026]. From
    then on, the gardener is referred to as Adam and accompanied by a female assistant
    gardener who, we later learn, is called Eve.\xAB<br><br> \u2013 Patricia de Vries
    (Against Gardening, 2021) \u2013"
