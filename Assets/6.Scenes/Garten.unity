    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
      propertyPath: storyID
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
      propertyPath: storyText
      value: "Der \xE4lteste G\xE4rtner kommt zu mir, nachdem ich stundenlang vor
        den K\xF6rnern ausgeharrt habe. \xBBThey dont\u2019t trust us. I think they
        might confuse the camera with a gun.\xAB \r\n\r\nIch muss an Susan Sontag
        denken und h\xF6re auf, zu fotografieren: \xBBJust as the camera is a sublimation
        of the gun, to photograph someone is a sublimated murder\u2014a soft murder,
        appropriate to a sad, frightened time.\xAB \r\n\r\n\u2013 Susan Sontag, (On
        Photography, 1977) \u2013"
      objectReference: {fileID: 0}
    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
