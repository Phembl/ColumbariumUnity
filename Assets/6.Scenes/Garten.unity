      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
      propertyPath: storyText
      value: "Bodenm\xFCdigkeit nennt man das auch. Aber warum arbeitet der Boden
        gegen die jungen Apfelb\xE4ume? Manche sagen, B\xE4ume, die Fr\xFCchte tragen,
        sind dazu gemacht, zu wandern. Tiere essen ihre Fr\xFCchte und verstreuen
        die Kerne weit weg vom Stamm. Die keimen dann an einem anderen Ort, wo sie
        neue Chancen und M\xF6glichkeiten haben zu wachsen, zu fruchten. Eine Pflanze
        findet ihren eigenen Weg, ihre eigene Wuchsrichtung."
      objectReference: {fileID: 0}
    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
      propertyPath: hasWorldText
      value: 1
