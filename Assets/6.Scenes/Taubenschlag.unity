      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
      propertyPath: storyID
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
      propertyPath: storyText
      value: "Als ich das erste Mal hier reingegangen bin, hat mich die Architektur
        an die eines <i>Panopticons</i> erinnert. Laut Michel Foucault \xBBeine Maschine,
        die ein Machtverh\xE4ltnis schaffen und aufrechterhalten kann, welches vom
        Machtaus\xFCbenden unabh\xE4ngig ist.\xAB \r\n\r\n\u2013 Michel Foucault,
        (\xDCberwachen und Strafen, 1975) \u2013\r\n\r\nDie einzelnen Zellen sind
        da, aber der Turm in der Mitte fehlt. Werde ich zum Turm, wenn ich in die
        Mitte des Raums trete?\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
      propertyPath: narrationAudio
