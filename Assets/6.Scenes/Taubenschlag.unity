      objectReference: {fileID: 0}
    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
      propertyPath: newMode
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
      propertyPath: storyID
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5114298124278996232, guid: c800375dfcf2b054db4f0d8af5576733, type: 3}
      propertyPath: storyText
      value: "An der Schale haftete eine Haut. Ich kenne es vom Eierpellen, manchmal
        bleibt sie an den abgebl\xE4tterten St\xFCcken h\xE4ngen. Manchmal wird sie
        an den R\xE4ndern sichtbar, wenn sie nicht exakt gleich wie die Schale abrei\xDFt.
        Manchmal bleibt sie auf dem Eiwei\xDF h\xE4ngen und man kann sie dort abziehen.
        \r\n\r\nIrgendwo habe ich ein Video gesehen, wie jemand die Kalkschale eines
        ungekochten Eis aufl\xF6st mit S\xE4ure oder irgendeinem Mittel und das harte
        undurchdringliche Ei wird weich und transparent. Durch die Schalenhaut schimmert
        der gelbe Dotter hindurch. \r\n\r\nIch lese: \xBBGelegentlich durchwandert
        das Ei den Uterus zu schnell. Es entstehen dann schalenlose Eier, sie werden
        Windeier genannt.\xAB\r\n"
      objectReference: {fileID: 0}
